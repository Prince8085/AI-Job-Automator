# AI Job Automator - Environment Configuration
# Copy this file to .env and replace with your actual API keys

# ===========================================
# REQUIRED: Google Gemini API Key
# ===========================================
# Get from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# REQUIRED: Clerk Authentication Keys
# ===========================================
# Get from: https://dashboard.clerk.com/
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# ===========================================
# RECOMMENDED: RapidAPI Key for Real Job Search
# ===========================================
# Get from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 200 requests/month
# Without this key, the app will show sample/demo jobs
VITE_RAPIDAPI_KEY=your_rapidapi_key_here

# ===========================================
# OPTIONAL: Database Configuration (Neon Postgres)
# ===========================================
# Get from: https://console.neon.tech/
# Required for persistent storage across devices
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ===========================================
# Application Settings
# ===========================================
# Set to 'false' to require authentication and use real data
# Set to 'true' to allow demo mode with sample data
VITE_DEMO_MODE=true